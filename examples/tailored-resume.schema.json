{
  "title": "Tailored resume companion JSON",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "job": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            }
          ]
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "company",
        "title"
      ]
    },
    "resume": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255
        }
      },
      "required": [
        "filename"
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "default": "",
          "type": "string",
          "maxLength": 254
        },
        "phone": {
          "default": "",
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "firstName",
        "lastName"
      ]
    },
    "links": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "default": "other",
            "type": "string",
            "enum": [
              "linkedin",
              "github",
              "portfolio",
              "other"
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              }
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "education": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "masterRecordId": {
            "type": "string",
            "maxLength": 64
          },
          "school": {
            "type": "string",
            "maxLength": 200
          },
          "degree": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "major": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "start": {
            "default": "",
            "type": "string",
            "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?)$"
          },
          "end": {
            "default": "",
            "type": "string",
            "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?)$"
          }
        },
        "required": [
          "school"
        ]
      }
    },
    "experience": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "masterRecordId": {
            "type": "string",
            "maxLength": 64
          },
          "employer": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "location": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "start": {
            "default": "",
            "type": "string",
            "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?)$"
          },
          "end": {
            "default": "",
            "type": "string",
            "pattern": "^(|\\d{4}(-(0[1-9]|1[0-2]))?)$"
          },
          "current": {
            "default": false,
            "type": "boolean"
          },
          "bullets": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "employer",
          "title"
        ]
      }
    },
    "projects": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "masterRecordId": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          },
          "bullets": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "skills": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "source": {
                "default": "resume",
                "type": "string",
                "enum": [
                  "resume",
                  "job",
                  "both"
                ]
              },
              "evidence": {
                "default": "",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "job",
    "resume",
    "candidate"
  ]
}
